# ===================================================================
# Sri Venkateswara Boys Hostel - Environment Configuration Template
# ===================================================================

# Server Port (Default: 8081)
PORT=8081

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/svboys_hostel

# Security / JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Meta WhatsApp Cloud API Configuration
# - When Meta WhatsApp Cloud API credentials are set, fee reminders dispatch automatically via Meta Cloud API.
# - Otherwise, the system prepares reminders in queue for 1-click dispatch via WhatsApp Web/App.
# Get your permanent access token and phone number ID from:
# https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_ENABLED=true
WHATSAPP_SANDBOX_MODE=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_NAME=hostel_fee_reminder
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_WEBHOOK_VERIFY_TOKEN=svbh_hostel_webhook_secret_2026

# Email / SMTP Configuration (Gmail App Password)
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=svbhostel2026@gmail.com
SPRING_MAIL_PASSWORD=your_gmail_app_password_here

# SMS Gateway Configuration (Fast2SMS)
SMS_PROVIDER=FAST2SMS
SMS_API_KEY=your_fast2sms_api_key_here
SMS_SENDER_ID=SVBHST
