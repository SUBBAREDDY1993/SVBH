{
  "name": "sri-venkateswara-boys-hostel",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Venkateswara Boys Hostel Management System",
  "scripts": {
    "start": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev": "powershell -ExecutionPolicy Bypass -File ./start-dev.ps1",
    "dev:backend": "powershell -ExecutionPolicy Bypass -File ./mvn.ps1 -f backend/pom.xml spring-boot:run",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "build:all": "npm run build:backend && npm run build:frontend",
    "build:backend": "powershell -ExecutionPolicy Bypass -File ./mvn.ps1 -f backend/pom.xml clean package -DskipTests",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
