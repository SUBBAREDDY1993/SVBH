{
  "name": "sri-venkateswara-boys-hostel",
  "version": "1.0.0",
  "private": true,
  "description": "Sri Venkateswara Boys Hostel Management System",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan.bold,magenta.bold\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "mvn.cmd -f backend/pom.xml spring-boot:run",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "mvn.cmd -f backend/pom.xml clean package -DskipTests",
    "build:frontend": "npm run build --prefix frontend",
    "install:all": "npm install && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
